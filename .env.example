# Resend - https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (use onboarding@resend.dev for testing - can only email your Resend account address)
# For customer confirmation emails, verify huntiez.com (or your domain) in Resend first.
RESEND_FROM="huntiez quotes <onboarding@resend.dev>"

# Optional override for quote inbox
QUOTE_TO_EMAIL=huntiezsobased@gmail.com

# Crypto wallets for purchase invoices (leave blank to disable an asset)
PURCHASE_WALLET_BTC=
PURCHASE_WALLET_ETH=
PURCHASE_WALLET_LTC=
PURCHASE_WALLET_USDC=
PURCHASE_WALLET_SOL=

# Optional ERC-20 USDC contract (defaults to Ethereum mainnet USDC)
# PURCHASE_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Optional override for crypto slippage tolerance in USD (default: 1% of invoice, min $0.01, max $1)
# PURCHASE_CRYPTO_TOLERANCE_USD=1

# Payment tolerance as a percentage (default 1). Matches BTCPay/BitPay-style rate protection.
PURCHASE_CRYPTO_TOLERANCE_PERCENT=1

# How long invoice rates stay locked in minutes (default 15)
PURCHASE_CRYPTO_LOCK_MINUTES=15
